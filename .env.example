# Canonical public URL: referral links, OG metadata, metadataBase, sitemap, JSON-LD. Use your real host (www or apex).
# NEXT_PUBLIC_SITE_URL=https://www.kroniqai.com

# Google Search Console — meta tag verification (content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: comma-separated sameAs profile URLs (Discord, X, LinkedIn) for Organization JSON-LD
# NEXT_PUBLIC_SAME_AS_SOCIALS=https://discord.gg/your-server

# Optional: primary community link if SAME_AS is unset
# NEXT_PUBLIC_DISCORD_URL=

# --- Supabase (waitlist, stats, leaderboard) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server only (required for `/api/waitlist/stats` and hero count = DB rows + offset). Not optional on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres (e.g. pooler) for waitlist when PostgREST cache is wrong.
# Get "Transaction" pooler URI from Supabase → Connect → use password from Database settings.
# Do not commit real credentials; use .env.local only.
# WAITLIST_DATABASE_URL=
# DATABASE_URL=

# Public hero count = exact integer: DB row count + offset. Default 40; set 0 to show only DB count.
# NEXT_PUBLIC_WAITLIST_DISPLAY_OFFSET=40

# NEXT_PUBLIC_WAITLIST_LEADERBOARD=false

# Optional: full-screen intro (shader + logo). Default off so the home page always paints immediately.
# NEXT_PUBLIC_KRONIQ_INTRO=1
