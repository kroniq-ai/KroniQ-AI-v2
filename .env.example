# Canonical public URL: referral links, OG metadata, metadataBase. Use your real host in production (www or apex).
# NEXT_PUBLIC_SITE_URL=https://www.kroniqai.com

# --- Supabase (waitlist, stats, leaderboard) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres (e.g. pooler) for waitlist when PostgREST cache is wrong.
# Get "Transaction" pooler URI from Supabase → Connect → use password from Database settings.
# Do not commit real credentials; use .env.local only.
# WAITLIST_DATABASE_URL=
# DATABASE_URL=

# Public hero count = DB count + offset. Default 100 in app if unset. Set 0 for exact DB count.
# NEXT_PUBLIC_WAITLIST_DISPLAY_OFFSET=100

# NEXT_PUBLIC_WAITLIST_LEADERBOARD=false

# Optional: full-screen intro (shader + logo). Default off so the home page always paints immediately.
# NEXT_PUBLIC_KRONIQ_INTRO=1
