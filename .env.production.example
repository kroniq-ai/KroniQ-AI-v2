# KroniQ marketing site (kroniqai.com) — Vercel env template
# Root directory: landing page/KroniQ-AI-v2-main

# Marketing site (use your canonical host — Vercel often redirects apex → www)
NEXT_PUBLIC_SITE_URL=https://www.kroniqai.com
NEXT_PUBLIC_APP_URL=https://app.kroniqai.com
NEXT_PUBLIC_APP_ACCESS=waitlist

# Local dev (marketing :3001 → app :3000):
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must match the same Supabase project as app.kroniqai.com (pilot users live in Auth → Users)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — share login session across kroniqai.com + app.kroniqai.com (defaults to .kroniqai.com)
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.kroniqai.com

# Optional waitlist display
NEXT_PUBLIC_WAITLIST_COUNT_FLOOR=0
NEXT_PUBLIC_WAITLIST_COUNT_PLUS=false

# Team-only legacy app routes on marketing domain (optional)
DEV_ACCESS_PASSWORD=
